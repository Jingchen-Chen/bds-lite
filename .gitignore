.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
*.egg-info/
data/
!src/bds_lite/data/
outputs/
recovered/
*.pt
*.npy
*.npz
*.pid

# Per-run training outputs; the per-case results the analyses need are in the evidence archives.
results/revision_runs/

# Runtime control state of the training supervisors, and the optional original-layout links
# (evidence/restore_original_layout.py); paths are fixed by the frozen study scripts.
/revision/

# Unlicensed upstream comparator code, fetched at a pinned commit; never redistributed.
third_party/

# Third-party papers fetched for number verification (hashes in paper/lit_numbers.csv).
paper/literature/

# Files that show dataset photographs or ACDC/Synapse annotations: local only, never committed
# (docs/LICENSING_AUDIT.md).
paper/restricted_local/
preregistration/

# Compiler intermediates are local caches; public paper builds retain only PDFs.
/paper/*.aux
/paper/*.log
/paper/*.bbl
/paper/*.blg
/paper/*.out

# Restored supporting records; the tracked copies are the evidence archives and manifests.
/protocols/
/docs/provenance/
/docs/LICENSING_AUDIT.md
/docs/REPRODUCIBILITY_STATUS_20261110.md
/results/*
!/results/README.md
!/results/tables/
!/results/paper_inputs/
!/results/followup/
/results/followup/*
!/results/followup/results/
/results/followup/results/*
!/results/followup/results/contrasts.csv

# Figure previews generated alongside the PDF assets used by the paper.
/paper/figures/*.png
